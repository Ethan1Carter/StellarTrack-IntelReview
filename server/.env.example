PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=星轨智评
INSTITUTION_NAME=高校五育综合评价平台

DB_DIALECT=postgres
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=5432
DB_NAME=student_assessment_test
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
DEFAULT_PASSWORD=change-this-temporary-import-password

# ---------- 注册系统 ----------
# 是否开放自助注册（true/false）；关闭后 /register 页面只展示提示，不接收提交
REGISTRATION_ENABLED=true
# 同一 IP 每小时最多提交多少次注册（0 = 不限制）；生产环境建议保留
REGISTRATION_RATE_MAX=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP

UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_UPLOAD_MAX_SIZE=524288000

# ---------- AI 材料审核 ----------
# 开启后调用 OpenAI 兼容接口；未配置密钥时自动使用本地规则降级模式
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=45000
